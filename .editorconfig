root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 130
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable

# import ordering layout
ij_kotlin_imports_layout = java,javax,kotlin,android,^,*

# IntelliJ IDEA options
ij_kotlin_indent_before_arrow_on_new_line = false
ij_kotlin_line_break_after_multiline_when_entry = false

# disable trailing commas
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

# enabled rules
ktlint_standard_no-unused-imports = enabled
ktlint_standard_import-ordering = enabled

# blank lines
ktlint_standard_no-consecutive-blank-lines = enabled
ktlint_standard_blank-line-before-declaration = disabled

# do not enforce function style
ktlint_standard_function-expression-body = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_function-signature = disabled

# disabled rules
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_package-name = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_no-empty-file = disabled

# preserve multiline parameter/argument formatting
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_multiline-if-else = disabled

# do not control function/class/enum line breaks
ktlint_standard_wrapping = disabled
ktlint_standard_function-type-reference-spacing = disabled
ktlint_standard_function-type-modifier-spacing = disabled
ktlint_standard_type-parameter-list-spacing = disabled
ktlint_standard_class-naming = disabled
ktlint_standard_enum-entry-name-case = disabled

# preserve existing line break style
ktlint_standard_max-line-length = disabled
ktlint_standard_parameter-wrapping = disabled
ktlint_standard_value-parameter-comment = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_condition-wrapping = disabled

# do not change comment/annotation positions
ktlint_standard_comment-wrapping = disabled
ktlint_standard_comment-spacing = disabled
ktlint_standard_annotation-spacing = disabled
ktlint_standard_binary-expression-wrapping = disabled

# preserve existing formatting
ktlint_standard_spacing-around-comma = disabled
ktlint_standard_spacing-around-colon = disabled
ktlint_standard_spacing-around-curly = disabled
ktlint_standard_spacing-around-dot = disabled
ktlint_standard_spacing-around-keyword = disabled
ktlint_standard_spacing-around-operators = disabled
ktlint_standard_spacing-around-parens = disabled
ktlint_standard_spacing-around-range-operator = disabled
ktlint_standard_spacing-around-unary-operator = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled

# additional formatting preservation
ktlint_standard_enum-entry-wrapping = disabled
ktlint_standard_curly-spacing = disabled
ktlint_standard_brace-wrapping = disabled

# class inheritance line breaks
ktlint_standard_class-signature = disabled
ktlint_standard_type-argument-list-spacing = disabled

[*.{kt,kts,gradle.kts}]
insert_final_newline = true
trim_trailing_whitespace = true
